{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "npm install --include=dev --prefix=..",
  "buildCommand": "cd .. && npx --no-install nx build @org/api-gateway --configuration=production --skip-nx-cache",
  "functions": {
    "src/index.js": {
      "includeFiles": "dist/**",
      "maxDuration": 60
    }
  }
}